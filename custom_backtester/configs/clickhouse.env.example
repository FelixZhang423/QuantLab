# ClickHouse 示意配置：复制为 clickhouse.local.env 后填写真实值。
# clickhouse.local.env 已被仓库根 .gitignore 的 **/*.local.env 忽略，不要提交。
# 也可以直接设置同名环境变量；环境变量优先于本文件。
QL_CH_HOST=<公司ClickHouse地址>
QL_CH_PORT=8123
QL_CH_USER=<用户名>
QL_CH_PASSWORD=<密码>

# 以下为可选项（括号内是默认值），按需取消注释
# QL_CH_TIMEOUT=30             # HTTP 超时秒数（30）
# QL_CH_MAX_EXECUTION_TIME=20  # 单条查询最长执行秒数（20）
# QL_CH_MAX_MEMORY=1000000000  # 单条查询内存上限，字节（1GB）
# QL_CH_CACHE_TTL=60           # 行情快照缓存秒数（60；设 0 表示不缓存）
# QL_CH_SCHEMA_TTL=300         # 表结构/股票信息缓存秒数（300）
# QL_CH_UNIVERSE_TTL=300       # 股票池候选快照秒数（300）
